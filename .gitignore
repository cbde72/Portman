# ============================================================
# PortmanNL – .gitignore
# ============================================================

# --- Python -------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Paketierung / Build ------------------------------------
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/
*.egg

# --- Virtuelle Umgebungen (227 MB) --------------------------
.venv/
venv/
env/
ENV/

# --- Test-/Lint-/Type-Caches --------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.dmypy.json
.tox/
.nox/
.hypothesis/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.cover
.test-tmp/

# --- Laufzeitdaten des Programms (persoenlich!) -------------
# Enthaelt Portfolio-SQLite, Einstellungen, Backups, Sessions.
data/
logs/
history/
factsheets/

# --- Generierte Laufzeit-Konfiguration im Projekt-Root ------
portfolio_settings.json
custom_charts.json
*.last-good
portman.lock

# --- Persoenliche Exporte (Konten/Portfolios) --------------
# Enthalten echte Namen und Kontonummern -> niemals versionieren.
*.portman.json

# --- SQLite-Reste / WAL / Backups ---------------------------
*.sqlite
*.sqlite-shm
*.sqlite-wal
*.sqlite-journal
*.tmp-shm
*.tmp-wal
*.db-journal

# --- Logs ---------------------------------------------------
*.log

# --- Editor / Betriebssystem --------------------------------
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# VS Code: geteilte Startkonfiguration wird versioniert
# (tests/test_ing_credentials.py prueft .vscode/launch.json),
# persoenliche Settings bleiben lokal.
.vscode/*
!.vscode/launch.json
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json

# --- Scratch-/Arbeitsverzeichnis (Audit-Laeufe, Debug-Daten) ---
tmp/

# --- Grosse generierte Audit-Dumps --------------------------
test_reports/pdf_parser_audit/run_001/
test_reports/pdf_parser_audit/v3_full_utf8/
test_reports/pdf_parser_audit/v3_full_utf8_rerun_*/
test_reports/**/progress.json

# --- Testpakete / Beispiel-PDFs in tools/ -------------------
tools/*.zip
tools/*.pdf

# --- Persoenliche Kontodaten in Reports (Repo ist oeffentlich!) ---
test_reports/comdirect_importtest_*.csv
test_reports/pdf_parser_audit/*_recheck*/

# --- Sonstiges ----------------------------------------------
*.bak
*.orig
*.rej
*.tmp
