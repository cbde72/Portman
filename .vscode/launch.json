
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "PortMan 09 starten",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "program": "${workspaceFolder}/src/Gui/PortMan_V09.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      }
    },
    {
      "name": "Portman PDF Lab – GUI",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "portman_pdf_lab",
      "args": ["gui"],
      "cwd": "${workspaceFolder}/portman-pdf-lab",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/portman-pdf-lab/src;${workspaceFolder}/portman-parsers/src"
      },
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
